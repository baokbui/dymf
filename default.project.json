{
  "name": "bvm",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },
      "Assets": {
        "$className": "Folder",
        "$ignoreUnknownInstances": true,
        "Brainrots": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true
        },
        "Monsters": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true
        },
        "Houses": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true
        }
      }
    },

    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },

    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },

    "StarterGui": {
      "MainUI": {
        "$className": "ScreenGui",
        "$properties": {
          "ResetOnSpawn": false,
          "ZIndexBehavior": "Sibling"
        },
        "Shop": {
          "$className": "Frame",
          "$properties": {
            "Visible": false,
            "BackgroundTransparency": 1
          }
        },
        "Coins": {
          "$className": "Frame",
          "$properties": {
            "Visible": false,
            "BackgroundTransparency": 1
          }
        },
        "LevelUI": {
          "$className": "Frame",
          "$properties": {
            "Visible": false,
            "BackgroundTransparency": 1
          }
        },
		"Settings": {
          "$className": "Frame",
          "$properties": {
            "Visible": false,
            "BackgroundTransparency": 1
          }
        },
        "Hearts": {
          "$className": "Frame",
          "$properties": {
            "Visible": false,
            "BackgroundTransparency": 1
          }
        },
        "Inventory": {
          "$className": "Frame",
          "$properties": {
            "Visible": false,
            "BackgroundTransparency": 1
          }
        },
        "RewardPopup": {
          "$className": "Frame",
          "$properties": {
            "Visible": false,
            "BackgroundTransparency": 1
          }
        }
      }
    },

    "Workspace": {
      "$properties": {
        "FilteringEnabled": true
      },
      "Plots": {
        "$className": "Folder"
      },
      "EnemyPaths": {
        "$className": "Folder"
      },
      "Maps": {
        "$className": "Folder"
      },
      "Baseplate": {
        "$className": "Part",
        "$properties": {
          "Anchored": true,
          "Color": [
            0.36862,
            0.52549,
            0.28627
          ],
          "Material": "Grass",
          "Locked": true,
          "Position": [
            0,
            -10,
            0
          ],
          "Size": [
            700,
            20,
            700
          ]
        }
      }
    },
    "Lighting": {
      "$properties": {
        "Ambient": [
          0,
          0,
          0
        ],
        "Brightness": 2,
        "GlobalShadows": true,
        "Outlines": false,
        "Technology": "Voxel"
      }
    },
    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}